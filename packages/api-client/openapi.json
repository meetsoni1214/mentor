  "info": {
    "title": "Mentor API",
    "description": "Single-owner authentication and service health. Mutations require Origin and X-CSRF-Token headers.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mentor-session"
      }
    },
    "schemas": {
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "CsrfDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 9,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "OwnerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "owner": {
            "$ref": "#/components/schemas/OwnerDto"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "owner",
          "expiresAt",
          "idleExpiresAt"
        ]
      }
    }
  }
}
