                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "api",
                        "worker"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or migrations missing"
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Mentor API",
    "description": "Single-owner authentication, continuous assistant conversation, and service health. Mutations require Origin and X-CSRF-Token headers. Conversation endpoints execute in the foreground; GET requests never start model work.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mentor-session"
      }
    },
    "schemas": {
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "CsrfDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 9,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "OwnerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "owner": {
            "$ref": "#/components/schemas/OwnerDto"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "owner",
          "expiresAt",
          "idleExpiresAt"
        ]
      },
      "AssistantLimitsDto": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "maxMessageBytes": {
            "type": "number",
            "minimum": 1
          },
          "maxContextBytes": {
            "type": "number",
            "minimum": 1,
            "description": "Initial transcript bound; excludes SDK overhead and intermediate items."
          },
          "maxOutputTokens": {
            "type": "number",
            "minimum": 1,
            "description": "Output-token setting per model call."
          },
          "deadlineMs": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "model",
          "maxMessageBytes",
          "maxContextBytes",
          "maxOutputTokens",
          "deadlineMs"
        ]
      },
      "AssistantStatusDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "limits": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AssistantLimitsDto"
              }
            ]
          }
        },
        "required": [
          "enabled",
          "limits"
        ]
      },
      "ConversationErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "enum": [
              "EXECUTION_UNAVAILABLE",
              "NOT_FOUND",
              "INVALID_INPUT",
              "STALE_HISTORY",
              "IDEMPOTENCY_CONFLICT",
              "BUSY",
              "NOT_RETRYABLE"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "ConversationTurnDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "requestId",
          "sequence",
          "text",
          "createdAt"
        ]
      },
      "SourceDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ]
      },
      "ActivityDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ]
          }
        },
        "required": [
          "type",
          "status"
        ]
      },
      "RunAttemptDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptNumber": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "interrupted"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deadlineAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "answer": {
            "type": "string",
            "nullable": true
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "PROVIDER_ERROR",
              "REFUSED",
              "INCOMPLETE",
              "INVALID_RESPONSE",
              "RATE_LIMITED",
              "LIMIT_EXCEEDED",
              "INTERRUPTED"
            ],
            "nullable": true
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceDto"
            }
          },
          "activity": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityDto"
            }
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "contextLimited": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "turnId",
          "requestId",
          "attemptNumber",
          "model",
          "state",
          "startedAt",
          "deadlineAt",
          "finishedAt",
          "answer",
          "errorCode",
          "sources",
          "activity",
          "inputTokens",
          "outputTokens",
          "contextLimited"
        ]
      },
      "ConversationAcceptedEventDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turn": {
            "$ref": "#/components/schemas/ConversationTurnDto"
          },
          "attempt": {
            "$ref": "#/components/schemas/RunAttemptDto"
          },
          "type": {
            "type": "string",
            "enum": [
              "accepted"
            ]
          },
          "replayed": {
            "type": "boolean",
            "description": "A replay reports saved state without attaching to a live run."
          }
        },
        "required": [
          "historyVersion",
          "turn",
          "attempt",
          "type",
          "replayed"
        ]
      },
      "ConversationTextDeltaEventDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "text_delta"
            ]
          },
          "delta": {
            "type": "string",
            "description": "Provisional answer text; never saved as context."
          }
        },
        "required": [
          "historyVersion",
          "turnId",
          "attemptId",
          "type",
          "delta"
        ]
      },
      "ConversationResultEventDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turn": {
            "$ref": "#/components/schemas/ConversationTurnDto"
          },
          "attempt": {
            "$ref": "#/components/schemas/RunAttemptDto"
          },
          "type": {
            "type": "string",
            "enum": [
              "result"
            ]
          }
        },
        "required": [
          "historyVersion",
          "turn",
          "attempt",
          "type"
        ]
      },
      "ConversationStreamErrorEventDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "STALE_HISTORY",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "historyVersion",
          "turnId",
          "attemptId",
          "type",
          "code",
          "message"
        ]
      },
      "HistoryTurnDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunAttemptDto"
            }
          }
        },
        "required": [
          "id",
          "requestId",
          "sequence",
          "text",
          "createdAt",
          "attempts"
        ]
      },
      "HistoryCursorDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "beforeSequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "historyVersion",
          "beforeSequence"
        ]
      },
      "ConversationHistoryDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryTurnDto"
            }
          },
          "nextCursor": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/HistoryCursorDto"
              }
            ]
          }
        },
        "required": [
          "historyVersion",
          "turns",
          "nextCursor"
        ]
      },
      "SubmitTurnDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Nonblank text, bounded by the configured UTF-8 message limit."
          }
        },
        "required": [
          "historyVersion",
          "requestId",
          "text"
        ]
      },
      "TurnResultDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turn": {
            "$ref": "#/components/schemas/ConversationTurnDto"
          },
          "attempt": {
            "$ref": "#/components/schemas/RunAttemptDto"
          }
        },
        "required": [
          "historyVersion",
          "turn",
          "attempt"
        ]
      },
      "RetryTurnDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "A fresh key for an explicit retry; reuse to reconcile that retry."
          }
        },
        "required": [
          "historyVersion",
          "requestId"
        ]
      },
      "HistoryVersionDto": {
        "type": "object",
        "properties": {
          "historyVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "historyVersion"
        ]
      }
    }
  }
}
