# Development values only. Keep real credentials out of version control.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3001
WORKER_PORT=3002
API_INTERNAL_URL=http://127.0.0.1:3001
APP_ORIGIN=http://127.0.0.1:3000
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=86400

# Compose and DATABASE_URL must describe the same database.
POSTGRES_USER=mentor
POSTGRES_PASSWORD=mentor_local_only
POSTGRES_DB=mentor
POSTGRES_PORT=55432
DATABASE_URL=postgresql://mentor:mentor_local_only@127.0.0.1:55432/mentor
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=3000

# AI configuration is validated server-side; the model adapter/API are later slices.
# Valid model/key configuration enables execution. Regular verification needs no key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
AI_MAX_MESSAGE_BYTES=8192
# Complete serialized input per request, including instructions and intermediate items.
AI_MAX_CONTEXT_BYTES=32768
# Output tokens, model requests and hosted-tool actions share whole-run allowances.
AI_MAX_OUTPUT_TOKENS=2048
AI_DEADLINE_MS=60000
AI_MAX_TOOL_CALLS=2
AI_MAX_MODEL_CALLS=3
