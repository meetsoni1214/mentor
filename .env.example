# Development values only. Keep real credentials out of version control.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3001
WORKER_PORT=3002
API_INTERNAL_URL=http://127.0.0.1:3001
APP_ORIGIN=http://127.0.0.1:3000
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=86400

# Compose and DATABASE_URL must describe the same database.
POSTGRES_USER=mentor
POSTGRES_PASSWORD=mentor_local_only
POSTGRES_DB=mentor
POSTGRES_PORT=55432
DATABASE_URL=postgresql://mentor:mentor_local_only@127.0.0.1:55432/mentor
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=3000

# AI configuration is server-only and read when the API starts; restart after changes.
# Valid model/key/limits enable authenticated submit/retry and can incur API charges.
# Blank/invalid settings disable execution; protected history reads/clearing still work.
# Bootstrap and deterministic tests need no key. The web conversation workspace is read-only.
# The SDK adapter enforces store:false, no retries, and no tracing/export in code.
# No tracing enable flag is provided; store:false does not mean zero provider retention.
# Never put this key in a NEXT_PUBLIC_ variable. No default model or enable flag is used.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Raw UTF-8 bytes per user message, not a character count.
AI_MAX_MESSAGE_BYTES=8192
# Initial serialized transcript size; excludes instructions, SDK overhead/intermediate items.
# Must be >= AI_MAX_MESSAGE_BYTES. Older messages remain readable outside model context.
AI_MAX_CONTEXT_BYTES=32768
# Per-model-call output setting; no cumulative token accounting or daily spending cap.
AI_MAX_OUTPUT_TOKENS=2048
# Persisted attempt deadline in milliseconds; process crashes do not auto-resume runs.
AI_DEADLINE_MS=60000
# Reserved for later hosted-search settings; no production tools are registered now.
AI_MAX_TOOL_CALLS=2
# Runner iteration limit uses the pinned SDK default (ten); no model-call setting exists.
