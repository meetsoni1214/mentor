{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": { "@/*": ["./apps/web/src/*"] },
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "tests/**/*.ts",
    "apps/web/tests/**/*.ts",
    "vitest*.ts",
    "packages/backend/src/**/*.ts"
  ]
}
